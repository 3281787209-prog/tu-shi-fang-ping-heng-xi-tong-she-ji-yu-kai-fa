# ========================================
# 土石方平衡系统 - 后端 FastAPI 环境变量
# 复制此文件为 .env 并根据实际情况修改
# ========================================

# 运行环境: dev / prod
ENV=dev

# JWT 签名密钥（生产环境必须修改为随机长字符串）
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LONG_STRING_PLEASE_USE_64_PLUS_CHARACTERS

# Token 有效期（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库连接
# SQLite（开发默认）：
DATABASE_URL=sqlite:///./data.db
# PostgreSQL（生产推荐）：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/earthwork
# MySQL：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/earthwork

# 允许跨域来源（逗号分隔多个）
# 本地开发：http://localhost:5173
# Render 部署：填你的前端域名，例如 https://your-app.onrender.com
# 也可以直接设为 * 允许所有
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 三维模型 VTP 文件缓存目录
# 默认相对路径：前端 public/model_cache
# Render 部署时建议设为：/var/data/model_cache 或 /opt/app/frontend/public/model_cache
# MODEL_CACHE_DIR=./frontend/public/model_cache
