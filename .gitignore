# =====================================================
# 土石方平衡系统 - .gitignore
# =====================================================

# ---------- Node.js / 前端 ----------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite 构建产物
frontend/rebuild-dist/
frontend/dist/
dist/

# ---------- Python / 后端 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/app/__pycache__/

# 虚拟环境
venv/
env/
.venv/
ENV/

# 数据库文件
*.db
*.sqlite
*.sqlite3
backend/data.db

# 环境变量（含密钥，禁止提交）
.env
backend/.env
!.env.example

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 其他 ----------
.cache/
.temp/
tmp/
